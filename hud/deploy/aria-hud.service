# systemd USER service (matches how the other tunnels/apps run here).
# Install (no sudo needed; linger keeps it running across reboots):
#   cp hud/deploy/aria-hud.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now aria-hud
#   loginctl enable-linger "$USER"   # once, so user services start at boot
[Unit]
Description=ARIA HUD web server (claudeclaw command center)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dmitriieremin/my-assistant/claudeclaw
EnvironmentFile=/home/dmitriieremin/my-assistant/claudeclaw/.env
ExecStart=/home/dmitriieremin/.nvm/versions/node/v22.22.1/bin/node /home/dmitriieremin/my-assistant/claudeclaw/hud/server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
